# Шаблон настроек. Локально: cp .env.example .env и правь при необходимости.
# .env НИКОГДА не коммитится (см. .gitignore).
# Единственный читатель значений — app/settings.py (через переменные окружения;
# на сервере их подставляет systemd: EnvironmentFile=.env в юнитах из deploy/).

# Redis: брокер очереди Celery + журнал заказов (job_store)
REDIS_URL=redis://localhost:6379/0

# Каталог заказов на диске. Локально можно не задавать (по умолчанию backend/storage).
# На сервере — абсолютный путь:
#STORAGE_DIR=/srv/browsercad-backend/storage

# Лимит загружаемого STEP, МБ (должен совпадать с client_max_body_size в nginx)
MAX_UPLOAD_MB=300

# Срок жизни готовых заказов, дней — ОДНО значение для Redis-TTL и чистки диска
RESULT_TTL_DAYS=3
